{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rocktimsaikia/zoko-mcp",
  "title": "Zoko",
  "description": "Read-only MCP server for integrating Zoko with AI assistants like Claude.",
  "version": "1.0.1",
  "repository": {
    "url": "https://github.com/rocktimsaikia/zoko-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "zoko-mcp",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ZOKO_API_KEY",
          "description": "Zoko API key, from https://app.live.zoko.io/more/webhooks/api",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
